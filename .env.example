# ── AI Safety Evaluation Platform — Environment Variables ──────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is listed in .gitignore — never commit it.
# This file (.env.example) is safe to commit; it contains no real secrets.

# ── Dataset paths ─────────────────────────────────────────────────────────────
# Path to the Jigsaw Toxic Comment train.csv you downloaded from Kaggle.
# https://www.kaggle.com/c/jigsaw-toxic-comment-classification-challenge
# Leave as-is if you extracted the Kaggle zip to data/raw/.
DATASET_CSV_PATH=data/raw/train.csv/train.csv

# Path to the Davidson hate-speech CSV (optional — leave blank to skip that dataset).
# https://github.com/t-davidson/hate-speech-and-offensive-language
DAVIDSON_CSV_PATH=

# ── Sampling ──────────────────────────────────────────────────────────────────
# Max rows to load from each dataset per pipeline run.
# Use a small number (e.g. 200) during development to keep runs fast.
# Set to 0 to load all rows (can be slow on the full Jigsaw dataset).
SAMPLE_SIZE=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# Create the database first: createdb trust_safety
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trust_safety

# ── LLM API keys (optional) ───────────────────────────────────────────────────
# Leave both blank to run entirely in fixture mode (no API calls, no cost).
# The pipeline will automatically enable USE_FIXTURES=true when no keys are present.

# OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API key — get one (free tier) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Model versions ────────────────────────────────────────────────────────────
# Change these if you want to test a different model version.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# ── Fixture mode ──────────────────────────────────────────────────────────────
# true  = use pre-recorded responses from FIXTURE_PATH (no API calls, no cost)
# false = call live LLM APIs (requires keys above)
# Automatically forced to true when both API keys are absent.
USE_FIXTURES=true

# Path to the pre-recorded LLM response fixture file used when USE_FIXTURES=true.
FIXTURE_PATH=tests/fixtures/llm_responses.json

# ── Pipeline control ──────────────────────────────────────────────────────────
# Set SKIP_INGEST=true to skip the CSV → PostgreSQL ingestion step and use
# whatever rows are already in the ground_truth table.
SKIP_INGEST=false

# ── Run tracking ──────────────────────────────────────────────────────────────
# A UUID that groups all predictions and metrics from one pipeline run.
# Leave blank to auto-generate a new UUID on each run.
# Set explicitly to re-use an ID (e.g. to rerun evaluation without re-ingesting).
RUN_ID=
